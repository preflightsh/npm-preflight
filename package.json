{
  "name": "@preflightsh/preflight",
  "version": "0.6.1",
  "description": "CLI tool that scans your codebase for launch readiness",
  "bin": {
    "preflight": "run.js"
  },
  "files": [
    "install.js",
    "run.js",
    "checksums.json"
  ],
  "scripts": {
    "postinstall": "node install.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preflightsh/npm-preflight.git"
  },
  "keywords": [
    "preflight",
    "cli",
    "deployment",
    "launch",
    "checklist",
    "seo",
    "security",
    "devops"
  ],
  "author": "Jon Phillips",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/preflightsh/preflight/issues"
  },
  "homepage": "https://preflight.sh",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "publishConfig": {
    "access": "public"
  }
}
